---
import type { CollectionEntry } from 'astro:content';
import ReadingTime from '@components/blog/ReadingTime.astro';
import Tag from '@components/ui/Tag.astro';
import { formatDate } from '@utils/formatDate';

interface Props {
  post: CollectionEntry<'blog'>;
  // 'default': 記事一覧(Archive/Tag/Pagination)で使う通常サイズ
  // 'compact': トップページの最新記事のような、限られた枠で情報密度を上げたい場所向け
  variant?: 'default' | 'compact';
}

const { post, variant = 'default' } = Astro.props;
const isCompact = variant === 'compact';
---

<article class="list-divider first:border-t-0">
  <a href={`/blog/${post.slug}/`} class="group block py-4 sm:py-5">
    <div class={`grid gap-2.5 sm:gap-5 ${isCompact ? 'sm:grid-cols-[120px_minmax(0,1fr)]' : 'sm:grid-cols-[148px_minmax(0,1fr)]'}`}>
      <div class="space-y-2 sm:pt-1">
        <div class="text-[11px] font-semibold uppercase tracking-[0.24em]" style="color: rgb(var(--text-muted));">
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
        </div>
        <div class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em]" style="border-color: rgb(var(--line)); color: rgb(var(--text-muted));">
          {post.data.category === 'daily' ? 'Daily Signal' : 'Deep Dive'}
        </div>
      </div>

      <div class="min-w-0">
        <div class="flex items-start justify-between gap-4">
          <h3
            class:list={[
              'max-w-3xl leading-[1.38] tracking-tight transition-colors group-hover:text-[rgb(var(--accent))]',
              isCompact ? 'text-lg sm:text-xl' : 'text-[1.55rem] sm:text-[1.85rem]',
            ]}
            style="font-family: var(--font-display);"
          >
            {post.data.title}
          </h3>
          <span class="hidden pt-1 text-base transition-transform duration-200 group-hover:translate-x-1 sm:inline-block" style="color: rgb(var(--text-muted));" aria-hidden="true">
            →
          </span>
        </div>

        <p
          class:list={[
            'mt-1 max-w-3xl leading-5 sm:leading-[1.32]',
            isCompact ? 'line-clamp-2 text-sm' : 'text-sm sm:text-base',
          ]}
          style="color: rgb(var(--text-muted));"
        >
          {post.data.description}
        </p>

        <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
          <div class="flex flex-wrap gap-x-2 gap-y-0.5">
            {post.data.tags.slice(0, 3).map((tag) => <Tag name={tag} />)}
          </div>
          <ReadingTime content={post.body} />
        </div>
      </div>
    </div>
  </a>
</article>
