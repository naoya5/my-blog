---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  // true: <details> で折りたたむモバイル/タブレット用。false: lg以上のサイドレール用（追従・スクロールスパイ対象）。
  collapsible?: boolean;
}

const { headings, collapsible = false } = Astro.props;
const visibleHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---

{
  visibleHeadings.length > 0 && (
    collapsible ? (
      <details class="toc-details">
        <summary class="toc-summary">目次</summary>
        <ul class="toc-list">
          {visibleHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'toc-item toc-item-sub' : 'toc-item'}>
              <a href={`#${heading.slug}`} class="toc-link" data-toc-link data-toc-target={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <nav class="toc-nav" aria-label="目次">
        <h2 class="toc-nav-title">目次</h2>
        <ul class="toc-list">
          {visibleHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'toc-item toc-item-sub' : 'toc-item'}>
              <a href={`#${heading.slug}`} class="toc-link" data-toc-link data-toc-target={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  )
}
